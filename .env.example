# Copy to .env (gitignored) and fill in. direnv loads it automatically.
# In the cloud these come from Secret Manager, injected by Cloud Run as env vars.

# Database (matches compose.yaml)
DATABASE_URL=postgres://triage:triage@127.0.0.1:15432/triage?sslmode=disable

# LLM providers — leave empty the ones you don't use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Local model via Ollama's OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Tracing (OTLP gRPC to the compose Jaeger; UI at http://127.0.0.1:16686).
# Unset: no tracing. Host workers use the host port; containers the service name.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:14317
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

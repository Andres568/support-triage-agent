# Loaded automatically by direnv on `cd`, unloaded on leave.
use flake

# Per-project gcloud config: this repo never sees ~/.config/gcloud credentials.
# Application Default Credentials (used by Terraform and Go SDKs) resolve here too.
export CLOUDSDK_CONFIG="$PWD/.gcloud"

# Isolate containers, networks and volumes from other Compose projects.
export COMPOSE_PROJECT_NAME="triage-agent"

# Local secrets and overrides (gitignored). See .env.example.
dotenv_if_exists .env

# Per-project GitHub CLI credentials: never the global ~/.config/gh ones.
export GH_CONFIG_DIR="$PWD/.gh"
